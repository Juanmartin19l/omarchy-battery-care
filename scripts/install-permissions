#!/bin/bash
# Lets members of the wheel group write the Lenovo charge mode
# (/sys/class/power_supply/BAT*/charge_types) without sudo.
# Re-applied by udev on every boot. Run once as root.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "Run as root (sudo $0)" >&2; exit 1; }
RULE=/etc/udev/rules.d/99-omarchy-lenovo-battery-care.rules
cat > "$RULE" <<'RULES'
# io.github.juanmartin19l.battery-care: allow wheel to change the Lenovo charge mode
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT[0-9]", TEST=="charge_types", RUN+="/bin/chgrp wheel /sys%p/charge_types", RUN+="/bin/chmod g+w /sys%p/charge_types"
RULES
udevadm control --reload
udevadm trigger --subsystem-match=power_supply --action=change
sleep 1
ls -l /sys/class/power_supply/BAT*/charge_types
